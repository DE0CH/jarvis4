{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FreezeCredentials",
      "Effect": "Allow",
      "Action": "sts:GetFederationToken",
      "Resource": "arn:aws:sts::795109470764:federated-user/hermit-freeze"
    },
    {
      "Sid": "FrozenImages",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::jarvis4-fabric-images-795109470764/frozen/*"
    },
    {
      "Sid": "UnusedImages",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::jarvis4-fabric-images-795109470764/images/*"
    },
    {
      "Sid": "ListImages",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::jarvis4-fabric-images-795109470764",
      "Condition": {
        "StringLike": {
          "s3:prefix": "images/*"
        }
      }
    }
  ]
}
