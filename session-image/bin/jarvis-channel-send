#!/usr/bin/env python3
"""Put a message into this session's claude through the Jarvis channel (bin/jarvis-channel), and wait for its receipt.

  jarvis-channel-send [--from NAME] < text

Prints one JSON line in the shape the old peer sender printed ({"success", "message", "ack"}); "target session not
found" while no channel is listening (claude is still starting), so Jarvis retries. Used by jarvis-machine
(machine/deliver.go sendToHarness) and the router's resume-prompt path (router/peer.go peerCommand).
"""
import json, os, sys, time, uuid

SPOOL = os.environ.get("JARVIS_CHANNEL_DIR") or os.path.expanduser("~/.claude/jarvis-channel")


def done(ok, msg):
    print(json.dumps({"success": ok, "message": msg, "ack": ""}))
    sys.exit(0 if ok else 1)


def alive():
    try:
        pid = int(open(os.path.join(SPOOL, "server.pid")).read().strip())
        os.kill(pid, 0)
        return True
    except Exception:
        return False


frm = "jarvis"
if len(sys.argv) == 3 and sys.argv[1] == "--from":
    frm = sys.argv[2]
text = sys.stdin.read()
if not text.strip():
    done(False, "empty message")
if not alive():
    done(False, "target session not found: no Jarvis channel is listening (claude is starting)")
name = "%d-%s.json" % (time.time_ns(), uuid.uuid4().hex[:8])
tmp = os.path.join(SPOOL, "." + name)
with open(tmp, "w") as f:
    json.dump({"text": text, "from": frm}, f)
os.replace(tmp, os.path.join(SPOOL, "in", name))
for _ in range(100):  # 20 s
    if os.path.exists(os.path.join(SPOOL, "done", name)):
        done(True, "delivered through the Jarvis channel")
    time.sleep(0.2)
try:
    os.remove(os.path.join(SPOOL, "in", name))
except OSError:
    pass
done(False, "target session not found: the Jarvis channel didn't take the message within 20 s")
