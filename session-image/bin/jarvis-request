#!/usr/bin/env python3
"""Ask Deyao for something that needs his Face ID, from inside a Jarvis 4 session: a request in the Inbox of the
Jarvis 4 app (docs/API.md "Requests"). He sees exactly what would be signed, the call this made (the router names
this session as the caller, from the machine's key) and the reason given here, and allows or denies it.

  jarvis-request add-repo OWNER/NAME --why TEXT [--sensitive] [--no-store]
                                    a deploy key (read + push) for a repo, in its own store (github-NAME), which comes
                                    into THIS session in the same approval (one Face ID); a waiter pulls it into
                                    the supervisor (RAM) and sets up its SSH key. --no-store: only make the key (e.g. for a
                                    proposed session's repos)
  jarvis-request grant HOLDER [--minutes N | --days N] --why TEXT
                                    let a router feature into THIS session (terminal, status, archive,
                                    remote): 1-10 minutes, or a standing rule for N days
  jarvis-request unlock --why TEXT the locked stores this session waits on
  jarvis-request add-store STORE --why TEXT
                                    one more store for this running session (its machine keeps its keys); once
                                    approved (within 1 h) the supervisor pulls it (a background waiter asks)
  jarvis-request new-session --label TEXT --prompt-file FILE [--stores a,b] [--repos URL,URL] [--model M]
                  [--size small|medium|large] [--harness claude] [--account NAME] [--request-id ID]
                  [--attach FILE]… --why TEXT
                                    propose a NEW session: it appears in the Inbox like the app's New session and starts
                                    only when Deyao approves it with Face ID (at most 3 waiting).
                                    --account: its Claude account (claude-<name> or <name>; Settings → Claude
                                    accounts lists them), kept for the session's life; default: Deyao's default one.
                                    --attach (repeatable, at most 20 files, 25 MB each): files sent with the first
                                    prompt, as the app's New session attaches them: uploaded to the router first, their
                                    sha256 + size signed with the line (the approval shows each, images with a preview),
                                    and the new session finds them in ~/uploads
  jarvis-request batch (--file FILE | --item ITEM… | --item-json JSON…) --summary TEXT
                                    several of the above as ONE Inbox entry, allowed together under one Face ID (or
                                    denied together). FILE: a JSON list of items, each {"intent": …} plus that
                                    intent's fields: {"intent":"repo/add","repo":"OWNER/NAME"},
                                    {"intent":"grant","holder":"terminal","minutes":5}, {"intent":"unlock"},
                                    {"intent":"add-store","store":"gmail"},
                                    {"intent":"call","method":"POST","path":"/api/sessions/ID/resume","body":{…}}
                                    (an app API call run as Deyao, as `jarvis4-actions.py request call`; read its result
                                    with `jarvis4-actions.py call-result ID`),
                                    {"intent":"new-session","label":…,"prompt":…,"stores":[…],"repos":…,
                                    "attach":["FILE",…]} (attach: files uploaded first, as --attach),
                                    {"intent":"peer","to":SESSION,"text":…} (a message to another session, as
                                    `jarvis-message`: upward waits in the batch for Deyao's tap, equal or downward
                                    is delivered at once when the batch is filed: its item says "delivering");
                                    or --item INTENT,key=value,… once per item (e.g. --item grant,holder=status,minutes=5),
                                    or --item-json '{"intent":…}' for an item with a JSON body or commas;
                                    an item may carry its own "explanation"; --summary (required) says what the
                                    whole batch is for. At most 20 items; a batch counts as one of the 3 waiting
                                    proposals. Every item is checked first: one bad item and nothing is filed
  jarvis-request list              this session's requests still waiting
  jarvis-request outcomes          what became of this session's requests (approved, denied, lapsed, dropped, failed)
  jarvis-request wait ID [--timeout SECONDS]
                                    block until the request (an Inbox id, a batch id, or for add-store this session's
                                    id) is decided, then print its outcome (default timeout 660 s; exit 0 approved,
                                    1 anything else, 2 still waiting)

A session asks for itself by default (grant, unlock, add-store; another session by naming it), for repos, and proposes new sessions; --why is required (plain
text, at most 600 characters, 8 lines). Nothing happens until Deyao allows it; a request goes after 10 minutes.
Once it is decided, the outcome arrives in this session by itself as a message from Jarvis ("[Inbox outcome] …", per
item for a batch; a paused session gets it when it runs again), so there is no need to poll; `wait` is for a script
that must block on it.
Goes through the machine's local proxy ($JARVIS_URL, machine/apiproxy.go), which signs it with the machine key.
"""
import json, os, subprocess, sys, urllib.error, urllib.request

BASE = os.environ.get("JARVIS_URL", "http://127.0.0.1:7171").rstrip("/")


def call(method, path, body=None):
    req = urllib.request.Request(BASE + path, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Content-Type": "application/json"})
    try:
        return json.load(urllib.request.urlopen(req, timeout=60))
    except urllib.error.HTTPError as e:
        b = e.read()
        try:
            msg = json.loads(b).get("error", b[:300])
        except Exception:
            msg = b[:300]
        raise SystemExit(f"{method} {path}: HTTP {e.code}: {msg}")


def upload(paths):
    """--attach: the files staged on the router as one upload (PUT /api/sessions/ID/uploads/UPLOAD/NAME, raw bytes)
    -> the proposal's attachments {uploadId, files: [{name}]} (the names as the router made them safe)"""
    import secrets, urllib.parse
    sid = os.environ.get("JARVIS2_SESSION_ID") or os.environ.get("SESSION_ID")
    if not sid:
        raise SystemExit("--attach: no JARVIS2_SESSION_ID in the environment (not a Jarvis 4 session?)")
    if len(paths) > 20:
        raise SystemExit(f"--attach: {len(paths)} files, at most 20")
    uid, names = "p" + secrets.token_hex(8), []
    for p in paths:
        p = os.path.expanduser(p)
        if not os.path.isfile(p):
            raise SystemExit(f"--attach {p}: not a file")
        if os.path.getsize(p) > 25 << 20:
            raise SystemExit(f"--attach {p}: larger than 25 MB")
        with open(p, "rb") as f:
            data = f.read()
        path = f"/api/sessions/{sid}/uploads/{uid}/" + urllib.parse.quote(os.path.basename(p), safe="")
        req = urllib.request.Request(BASE + path, method="PUT", data=data, headers={"Content-Type": "application/octet-stream"})
        try:
            out = json.load(urllib.request.urlopen(req, timeout=300))
        except urllib.error.HTTPError as e:
            b = e.read()
            try:
                msg = json.loads(b).get("error", b[:300])
            except Exception:
                msg = b[:300]
            raise SystemExit(f"--attach {p}: HTTP {e.code}: {msg}")
        if out["name"] in names:
            raise SystemExit(f"--attach {p}: another file is already named {out['name']}")
        names.append(out["name"])
        print(f"attached {p} as {out['name']} ({out['size']} bytes)", file=sys.stderr)
    return {"uploadId": uid, "files": [{"name": n} for n in names]}


def parse_item(spec):
    """--item INTENT,key=value,…: one batch item (numbers become numbers, true/false booleans, a|b lists)"""
    parts = spec.split(",")
    item = {"intent": parts[0]}
    for kv in parts[1:]:
        if "=" not in kv:
            raise SystemExit(f"--item {spec}: {kv!r} is not key=value")
        k, v = kv.split("=", 1)
        item[k] = int(v) if v.isdigit() else {"true": True, "false": False}.get(v, v.split("|") if "|" in v else v)
    return item


def opt(args, name):
    if name in args:
        i = args.index(name)
        if i + 1 >= len(args):
            raise SystemExit(f"{name} needs a value")
        v = args[i + 1]
        del args[i:i + 2]
        return v
    return None


def repo_store(repo):
    """the repo's store, as the router and core name it: github-<name> for DE0CH's repos, else github-<owner>-<name>"""
    r = repo.strip().lower()
    for p in ("https://github.com/", "git@github.com:"):
        r = r[len(p):] if r.startswith(p) else r
    r = r.rstrip("/")
    r = r[:-4] if r.endswith(".git") else r
    owner, _, name = r.partition("/")
    slug = name if owner == "de0ch" else owner + "-" + name
    return "github-" + "".join(c if c.isalnum() and c.isascii() else "-" for c in slug).strip("-")


def start_await(store):
    """the approval only lands in the cert: a detached waiter pulls the store's secrets once it does (no second ask; a
    foreground wait would outlive a tool call's timeout)"""
    log = os.path.expanduser("~/.jarvis-await-" + "".join(c if c.isalnum() or c in "-_" else "_" for c in store) + ".log")
    with open(log, "ab") as f:
        subprocess.Popen(["jarvis-machine", "await-store", store], stdout=f, stderr=f, stdin=subprocess.DEVNULL,
                         start_new_session=True)
    print(f"Once he allows {store}, the supervisor pulls it by itself (log: {log}); then run a command with the keys it "
          "needs as `session-secret --keys K1,K2 --exec CMD` (this shell's env doesn't change).", file=sys.stderr)


def show(o):
    line = f"{o['ref']} {o['kind']} {o['outcome'].upper()}"
    if o.get("batch"):
        line += f" (batch {o['batch']} item {o['item'] + 1})"
    if o.get("status"):
        line += f" HTTP {o['status']}"
    line += " at " + o["at"]
    if not o.get("delivered"):
        line += " (not yet delivered as a message)"
    elif o.get("error"):
        line += " (" + o["error"] + ")"
    print(line)


def wait(ref, timeout):
    """until an outcome names ref (an Inbox id, a session id) or a batch id and nothing of it still waits"""
    import time
    deadline = time.time() + timeout
    while True:
        outs = [o for o in call("GET", "/api/requests/outcomes")["outcomes"] if ref in (o["ref"], o.get("batch"))]
        pending = call("GET", "/api/requests")
        waiting = any(ref in (q["id"], q.get("batch"), q.get("session")) for q in pending["requests"]) or \
            any(b["id"] == ref for b in pending.get("batches") or [])
        if outs and not waiting:
            for o in outs:
                show(o)
            return 0 if all(o["outcome"] == "approved" for o in outs) else 1
        if time.time() > deadline:
            for o in outs:
                show(o)
            print(f"{ref}: still waiting in Deyao's Inbox", file=sys.stderr)
            return 2
        time.sleep(5)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        raise SystemExit(__doc__)
    if args[0] == "outcomes":
        for o in call("GET", "/api/requests/outcomes")["outcomes"]:
            show(o)
        return
    if args[0] == "wait":
        rest = args[1:]
        t = opt(rest, "--timeout")
        if len(rest) != 1:
            raise SystemExit("wait ID [--timeout SECONDS]")
        raise SystemExit(wait(rest[0], int(t) if t else 660))
    if args[0] == "list":
        out = call("GET", "/api/requests")
        for q in out["requests"]:
            print(q["id"], q["kind"], json.dumps(q.get("params") or {}, sort_keys=True), "waiting since", q["created"],
                  ("in batch " + q["batch"]) if q.get("batch") else "")
        for b in out.get("batches") or []:
            print(b["id"], "batch of", len(b["items"]), "(+%d preparing)" % b["preparing"] if b.get("preparing") else "", "until", b["expires"], "|", b["summary"])
        return
    if args[0] == "batch":
        rest = args[1:]
        f, summary = opt(rest, "--file"), opt(rest, "--summary")
        inline = []
        while "--item" in rest:
            inline.append(parse_item(opt(rest, "--item")))
        while "--item-json" in rest:
            inline.append(json.loads(opt(rest, "--item-json")))
        if (not f and not inline) or not summary or rest:
            raise SystemExit("batch (--file FILE | --item INTENT,key=value,… | --item-json JSON) --summary TEXT (see --help)")
        items = []
        if f:
            with open(f) as fh:
                items = json.load(fh)
        if not isinstance(items, list):
            raise SystemExit("FILE must hold a JSON list of items")
        items = items + inline
        # a new-session item's "attach": every item checked here first, then each one's files uploaded
        for x in items:
            if x.get("intent") == "new-session" and "attach" in x:
                a = x["attach"]
                if isinstance(a, str):
                    a = [a]
                if not isinstance(a, list) or not a or not all(isinstance(p, str) and os.path.isfile(os.path.expanduser(p)) for p in a):
                    raise SystemExit(f"item {items.index(x)}: attach must name existing files")
        for x in items:
            if x.get("intent") == "new-session" and "attach" in x:
                a = x.pop("attach")
                x["attachments"] = upload([a] if isinstance(a, str) else a)
        out = call("POST", "/api/requests/batch", {"summary": summary, "items": items})
        # the added stores are pulled by a waiter each, as for a single add-store
        for x in items:
            if x.get("intent") == "add-store" and x.get("store"):
                start_await(x["store"])
            elif x.get("intent") == "repo/add" and x.get("repo") and not x.get("noStore"):
                start_await(repo_store(x["repo"]))  # its store comes in the same approval
        print(json.dumps(out))
        if not out.get("id"):  # nothing waits: only messages delivered at once (or a restore filed on its own)
            print("Nothing of it waits in the Inbox as a batch: see each item above.", file=sys.stderr)
            return
        print("Waiting in Deyao's Inbox as one batch (the Jarvis 4 app); nothing happens until he allows it. The outcome of "
              f"every item arrives in this session as a message once decided (or block: jarvis-request wait {out.get('id')}).",
              file=sys.stderr)
        return
    why = opt(args, "--why")
    new_session = {}
    if args[0] == "new-session":
        label, pf = opt(args, "--label"), opt(args, "--prompt-file")
        if not label or not pf:
            raise SystemExit("new-session needs --label and --prompt-file")
        with open(pf) as f:
            new_session = {"label": label, "prompt": f.read()}
        for flag, key in (("--model", "model"), ("--size", "size"), ("--harness", "harness"), ("--account", "account"), ("--request-id", "requestId")):
            v = opt(args, flag)
            if v:
                new_session[key] = v
        attach = []
        while "--attach" in args:
            attach.append(opt(args, "--attach"))
        stores, repos = opt(args, "--stores"), opt(args, "--repos")
        if stores:
            new_session["stores"] = [s for s in stores.split(",") if s]
        if repos:
            new_session["repos"] = ",".join(r for r in repos.split(",") if r)
    minutes, days = opt(args, "--minutes"), opt(args, "--days")
    sensitive, no_store = "--sensitive" in args, "--no-store" in args
    args = [a for a in args if a not in ("--sensitive", "--no-store")]
    if not why:
        raise SystemExit("--why TEXT is required: say why this is needed")
    kind, rest = args[0], args[1:]
    if kind == "add-repo" and len(rest) == 1:
        body = {"repo": rest[0], "explanation": why}
        if sensitive:
            body["sensitive"] = True
        if no_store:
            body["noStore"] = True
        out = call("POST", "/api/requests/repo/add", body)
        if not no_store:
            start_await(repo_store(rest[0]))
    elif kind == "grant" and len(rest) == 1:
        body = {"holder": rest[0], "explanation": why}
        if days:
            body["days"] = int(days)
        elif minutes:
            body["minutes"] = int(minutes)
        out = call("POST", "/api/requests/grant", body)
    elif kind == "unlock" and not rest:
        out = call("POST", "/api/requests/unlock", {"explanation": why})
    elif kind == "new-session" and not rest and new_session:
        if attach:
            new_session["attachments"] = upload(attach)
        out = call("POST", "/api/sessions", dict(new_session, explanation=why))
    elif kind == "add-store" and len(rest) == 1:
        out = call("POST", "/api/requests/add-store", {"store": rest[0], "explanation": why})
        start_await(rest[0])
    else:
        raise SystemExit(__doc__)
    print(json.dumps(out))
    ref = out.get("id") or os.environ.get("JARVIS2_SESSION_ID", "")
    print("Waiting in Deyao's Inbox (the Jarvis 4 app); nothing happens until he allows it. The outcome arrives in this "
          f"session as a message once decided (or block: jarvis-request wait {ref}).", file=sys.stderr)


if __name__ == "__main__":
    main()
