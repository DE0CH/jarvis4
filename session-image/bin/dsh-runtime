#!/bin/sh
# The DeepSeek Harness runtime bundle for a `dsh` session (harness-dsh.sh): Node and Deyao's dsh fork
# (DE0CH/deepseek-harness, npm-installed from its own release tarballs), fetched on first use (Fly's 8 GB image limit) from the GitHub release
# pinned in /opt/jarvis/dsh-runtime.json — by URL AND sha256, so the code that runs is fixed by this image's digest,
# not by whatever the release serves later (docs/DESIGN.md "Inputs to a machine"). A bundle that doesn't match is
# deleted and nothing runs. Prints the bundle's folder (node/, app/; the CLI is app/node_modules/.bin/dsh).
set -e
PIN=/opt/jarvis/dsh-runtime.json
url="$(python3 -I -c "import json;print(json.load(open('$PIN'))['url'])")"
want="$(python3 -I -c "import json;print(json.load(open('$PIN'))['sha256'])")"
[ -n "$url" ] && [ -n "$want" ] || { echo "dsh: no runtime bundle is pinned yet ($PIN)" >&2; exit 1; }
dir="$HOME/.cache/dsh-runtime/$(printf %.12s "$want")"
if [ ! -x "$dir/node/bin/node" ] || [ "$(cat "$dir/.sha256" 2>/dev/null)" != "$want" ]; then
  mkdir -p "$HOME/.cache/dsh-runtime"
  (
    flock 9
    if [ ! -x "$dir/node/bin/node" ] || [ "$(cat "$dir/.sha256" 2>/dev/null)" != "$want" ]; then
      echo "dsh: fetching the runtime bundle $(printf %.12s "$want")" >&2
      tmp="$dir.tmp.$$"; rm -rf "$tmp" "$dir"; mkdir -p "$tmp"
      curl -fsSL --retry 3 -o "$tmp.tgz" "$url"
      got="$(sha256sum "$tmp.tgz" | cut -d' ' -f1)"
      if [ "$got" != "$want" ]; then rm -rf "$tmp" "$tmp.tgz"; echo "dsh: the bundle's sha256 is $got, the image pins $want: refused" >&2; exit 1; fi
      tar -xzf "$tmp.tgz" -C "$tmp"; rm -f "$tmp.tgz"
      printf '%s' "$want" > "$tmp/.sha256"
      mv "$tmp" "$dir"
      for old in "$HOME/.cache/dsh-runtime"/*; do [ "$old" = "$dir" ] || case "$old" in *.lock) ;; *) rm -rf "$old";; esac; done
    fi
  ) 9>"$HOME/.cache/dsh-runtime/.lock"
fi
printf '%s\n' "$dir"
