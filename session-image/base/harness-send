#!/bin/bash
# Deliver a prompt (stdin) to this session's non-Claude-app harness — what Jarvis execs for the
# first prompt, scheduled wakeups / watches and Deyao's resume prompt, in place of
# the remote-control path's peer message / typed prompt. Never keystrokes, so it cannot answer a
# pending permission ask. Which harness is running decides the route:
#   opencode    (harness-opencode.sh)   `paseo send` to the session's MAIN agent (recorded in
#                                       ~/.claude/.paseo-agent); with no main agent yet it creates one.
#   paseo-claude (harness-paseo-claude.sh) the same, with Claude Code as the agent (`--provider claude`).
#   openclaw    (harness-openclaw.sh)   the gateway's `chat.send` into its main session
#                                       (agent:main:main) — the one the Control UI and the app open;
#                                       it answers "started" at once, the turn runs in the gateway.
#   dsh         (harness-dsh.sh)        dsh-send.py: a prompt (mode queue) into the main DeepSeek Harness
#                                       conversation (~/.claude/.dsh-session; made by the first prompt).
#   cloudcli    (harness-cloudcli.sh)   the CloudCLI server's POST /api/jarvis/deliver: a turn of its main
#                                       conversation (made by the first prompt), run with no client attached;
#                                       the server answers at once, 409 while a turn runs (→ 75).
#   harness-send [--images <file with space-separated image paths>] < prompt.txt
#   claude      (harness-claude.sh)     --queue only: Deyao's resume prompt, which the launcher's typing loop types
#                                       into the host's input box as his prompt (Jarvis's own messages go through
#                                       the Jarvis channel instead).
#   harness-send --queue < prompt.txt   spool it for the harness launcher's inbox loop and return at once.
#                                       What the JARVIS uses: delivery can take seconds (paseo) and
#                                       a Fly exec is cut off at ~60 s, so the exec only writes a
#                                       file; delivery (with retries) is local.
set -u
export HOME=/home/claude PATH="/home/claude/.local/bin:/usr/local/bin:/usr/bin:/bin"
# no secrets needed: the openclaw CLI reads the gateway token from its config, and paseo's daemon (started by the
# harness launcher, with the session's env) runs the agents; this client only talks to them
INBOX="$HOME/.claude/harness-inbox"
if pgrep -u "$(id -u)" -f harness-opencode.sh >/dev/null; then HARNESS=opencode
elif pgrep -u "$(id -u)" -f harness-paseo-claude.sh >/dev/null; then HARNESS=paseo-claude
elif pgrep -u "$(id -u)" -f harness-openclaw.sh >/dev/null; then HARNESS=openclaw
elif pgrep -u "$(id -u)" -f harness-cloudcli.sh >/dev/null; then HARNESS=cloudcli
elif pgrep -u "$(id -u)" -f harness-dsh.sh >/dev/null; then HARNESS=dsh
elif pgrep -u "$(id -u)" -f harness-claude.sh >/dev/null; then HARNESS=claude
else HARNESS=""; fi

if [ "${1:-}" = "--queue" ]; then
  TEXT="$(cat)"; [ -n "$TEXT" ] || { echo "harness-send: empty prompt" >&2; exit 2; }
  [ -n "$HARNESS" ] || { echo "harness-send: no harness launcher is running" >&2; exit 3; }
  mkdir -p "$INBOX"; f="$INBOX/$(date +%s%N).txt"; (umask 077; printf '%s' "$TEXT" > "$f.tmp") && mv "$f.tmp" "$f"
  echo '{"ok":true,"queued":true}'; exit 0
fi
IMGS=()
if [ "${1:-}" = "--images" ]; then read -r -a IMGS < "${2:-/dev/null}" || true; fi
TEXT="$(cat)"; [ -n "$TEXT" ] || { echo "harness-send: empty prompt" >&2; exit 2; }
# SESSION_* are the machine's env, which a Fly exec does not inherit: read them off the harness launcher
envof() { tr '\0' '\n' < "/proc/$(pgrep -o -u "$(id -u)" -f "harness-$2.sh")/environ" 2>/dev/null | sed -n "s/^$1=//p" | head -1; }

# ---------------------------------------------------------------- openclaw (gateway) -------------
if [ "$HARNESS" = openclaw ]; then
  # images: the gateway takes attachments as data; until then they go in as paths the agent can read
  for i in "${IMGS[@]:-}"; do [ -n "$i" ] && TEXT="$TEXT
[attached image: $i]"; done
  params="$(python3 -c 'import json,sys,uuid; print(json.dumps({"sessionKey":"agent:main:main","message":sys.stdin.read(),"idempotencyKey":"jarvis-"+uuid.uuid4().hex}))' <<< "$TEXT")"
  # the gateway token is in its config (the CLI reads it); the port is the harness's own
  exec /usr/local/bin/openclaw gateway call chat.send --json --timeout 45000 --params "$params"
fi

# ---------------------------------------------------------------- dsh (DeepSeek Harness web) -----
if [ "$HARNESS" = dsh ]; then
  WD="$(tr '\0' '\n' < /proc/"$(pgrep -u "$(id -u)" -of harness-dsh.sh)"/cmdline 2>/dev/null | sed -n 3p)"
  # not `… | exec`: an exec in a pipeline replaces only its subshell, and this script would go on to exit 3
  printf '%s' "$TEXT" | python3 /usr/local/bin/dsh-send.py "${WD:-$HOME/workspace}" "${IMGS[@]}"; exit $?
fi

# ---------------------------------------------------------------- cloudcli (CloudCLI server) -----
if [ "$HARNESS" = cloudcli ]; then
  # images: the server takes uploads from its own store only; these go in as paths Claude Code can read
  for i in "${IMGS[@]:-}"; do [ -n "$i" ] && TEXT="$TEXT
[attached image: $i]"; done
  body="$(python3 -c 'import json,sys; print(json.dumps({"content": sys.stdin.read()}))' <<< "$TEXT")"
  out="$(curl -s -m 30 -w '\n%{http_code}' -H 'content-type: application/json' --data-binary "$body" http://127.0.0.1:3001/api/jarvis/deliver)"
  code="${out##*$'\n'}"; out="${out%$'\n'*}"
  case "$code" in
    202) echo "$out"; exit 0 ;;
    409) echo "harness-cloudcli: the main conversation is running a turn; the message waits for it to end" >&2; exit 75 ;;
    *) echo "harness-send: the CloudCLI server answered ${code:-nothing}: $out" >&2; exit 1 ;;
  esac
fi

# ---------------------------------------------------------------- Paseo: opencode | paseo-claude ---
[ "$HARNESS" = opencode ] || [ "$HARNESS" = paseo-claude ] || { echo "harness-send: no harness launcher is running" >&2; exit 3; }
export PASEO_HOME="$HOME/.paseo"
REC="$HOME/.claude/.paseo-agent"
IMG_ARGS=(); for i in "${IMGS[@]:-}"; do [ -n "$i" ] && IMG_ARGS+=(--image "$i"); done
WD="$HOME/workspace"; mapfile -t DIRS < <(find "$WD" -mindepth 1 -maxdepth 1 -type d 2>/dev/null); [ "${#DIRS[@]}" = 1 ] && WD="${DIRS[0]}"
MODEL="${SESSION_MODEL:-$(envof SESSION_MODEL "$HARNESS")}"; LABEL="${SESSION_LABEL:-$(envof SESSION_LABEL "$HARNESS")}"

id="$(cat "$REC" 2>/dev/null)"
if [ -n "$id" ] && ls "$PASEO_HOME"/agents/*/"$id".json >/dev/null 2>&1; then
  # Paseo's send interrupts a running turn (activeTurnBehavior "interrupt"; the CLI can't steer): for Claude Code
  # a message waits until the main agent is idle instead. 75 = busy, try again later (the inbox loop doesn't
  # count it as a failed try).
  if [ "$HARNESS" = paseo-claude ] && python3 -c 'import glob,json,sys; a=json.load(open(glob.glob(sys.argv[1])[0])); sys.exit(0 if a.get("lastStatus") in ("running","initializing") else 1)' "$PASEO_HOME/agents/*/$id.json" 2>/dev/null; then
    echo "harness-send: the main agent is running a turn; the message waits for it to end" >&2; exit 75
  fi
  f="$(mktemp)"; printf '%s' "$TEXT" > "$f"
  paseo send "$id" --no-wait --prompt-file "$f" "${IMG_ARGS[@]}" --json; rc=$?; rm -f "$f"; exit $rc
fi
if [ "$HARNESS" = paseo-claude ]; then
  # the permission mode as harness-paseo-claude.sh maps it (the in-place file wins over the boot env)
  PERM="$(cat "$HOME/.claude/.permission-mode" 2>/dev/null || envof SESSION_PERMISSION_MODE paseo-claude)"
  MODE=auto; [ "$PERM" = bypass ] && MODE=bypassPermissions
  MODEL="${MODEL:-paseo/claude-opus-5-5}"
  RUN=(--provider claude --model "${MODEL#paseo/}" --mode "$MODE")
else
  RUN=(--provider opencode --model "${MODEL:-openrouter/z-ai/glm-5.3}" --mode build)
fi
out="$(cd "$WD" && paseo run -d "${RUN[@]}" ${LABEL:+--title "$LABEL"} "${IMG_ARGS[@]}" --json -- "$TEXT")" || { echo "$out" >&2; exit 1; }
id="$(printf '%s' "$out" | python3 -c 'import json,sys;s=sys.stdin.read();print(json.loads(s[s.index("{"):]).get("agentId",""))' 2>/dev/null)"
[ -n "$id" ] || { echo "harness-send: no agent id in: $out" >&2; exit 1; }
printf '%s' "$id" > "$REC"; echo "{\"ok\":true,\"agentId\":\"$id\",\"created\":true}"
