#!/usr/bin/env python3
"""Ask the supervisor for SPECIFIC keys of this session's secrets — WITHOUT ever printing a value.

The supervisor (jarvis-machine, machine/secrets.go) holds the session's stores in RAM. A process's env is fixed when
it starts, so a store added or refreshed afterwards reaches a command only through this. Every request names its keys:
there is no way to ask for all of them (the supervisor has no such request and refuses one with no keys), and a key
the session doesn't hold is an error naming it. Asking never pulls: it serves what the supervisor holds now (`pull-secrets` makes it pull from the core). The supervisor log records the key names asked for
and this process's pid, never a value.

Safety: stdout ends up in the session transcript, so NO mode prints a secret value. Anything that isn't exactly one of
the commands below (no args, --help, a typo, a missing argument, a bad key name) prints this usage and exits 2
WITHOUT asking the supervisor.

Usage:
  session-secret --names                          # the key names held, one per line
  session-secret --keys K1,K2 --exec CMD [ARG...] # run CMD with those keys added to its environment
                                                  #   (e.g. session-secret --keys EXA_API --exec python3 s.py);
                                                  #   make sure CMD itself doesn't echo them
  session-secret --keys K1,K2 --write FILE        # write `export K='value'` lines to FILE (mode 600);
                                                  #   prints only the key names

It asks the supervisor's unix socket (/run/jarvis/secrets.sock, only this user can reach it).
"""
import json, os, re, shlex, socket, sys

SOCK = "/run/jarvis/secrets.sock"
NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


def die(msg, code=1):
    print(f"session-secret: {msg}", file=sys.stderr); sys.exit(code)


def usage():
    print(__doc__.strip(), file=sys.stderr); sys.exit(2)


def ask(req):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(60)
        s.connect(SOCK)
        s.sendall((json.dumps(req) + "\n").encode())
        buf = b""
        while True:
            b = s.recv(65536)
            if not b:
                break
            buf += b
        s.close()
        r = json.loads(buf.decode() or "{}")
    except (OSError, ValueError) as e:
        die(f"the supervisor's secrets aren't reachable ({e.__class__.__name__})")
    if not r.get("ok"):
        die("the supervisor said: " + str(r.get("error", "no answer"))[:300])
    return r


def get(ks):
    secrets = ask({"op": "get", "keys": ks}).get("secrets") or {}
    missing = [k for k in ks if k not in secrets]
    if missing:
        die("not held in this session: " + ", ".join(missing))
    return secrets


def keys_of(arg):
    ks = [k for k in arg.split(",") if k]
    if not ks or not all(NAME.match(k) for k in ks):
        usage()
    return list(dict.fromkeys(ks))


def main():
    a = sys.argv[1:]
    # validate BEFORE asking: a wrong invocation must never reach the values
    if a == ["--names"]:
        for k in ask({"op": "names"}).get("names") or []: print(k)
    elif len(a) == 4 and a[0] == "--keys" and a[2] == "--write" and not a[3].startswith("-"):
        ks = keys_of(a[1])
        secrets = get(ks)
        with open(os.open(a[3], os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            for k in ks: f.write(f"export {k}={shlex.quote(str(secrets[k]))}\n")
        os.chmod(a[3], 0o600)
        print(f"wrote {len(ks)} secret(s) to {a[3]}: {', '.join(ks)}")
    elif len(a) >= 4 and a[0] == "--keys" and a[2] == "--exec":
        ks = keys_of(a[1])
        secrets = get(ks)
        os.execvpe(a[3], a[3:], {**os.environ, **{k: str(secrets[k]) for k in ks}})
    else:
        usage()


if __name__ == "__main__":
    main()
