#!/usr/bin/env python3
"""aviary-home HOME IMAGE_HOME (harness-aviary.sh, as the home's owner): gives a session's home what the home of
DE0CH/aviary's sandbox image holds (IMAGE_HOME = the unpacked image's /home/sandbox: today the links
~/.claude -> .harness/claude and ~/.qwen -> .harness/qwen, the empty ~/.harness and ~/.npmrc). What it holds is read
from the image, not written here: a link the image adds is made here too.

Dogfooding (Deyao, 2026-11-14): a session's sandbox runs in aviary's image with the machine's home bound to
/home/sandbox, and Claude Code must find its home there exactly as in any aviary sandbox, through the image's link
into the supervisor's mount (/home/sandbox/.harness), with nothing of Jarvis 4's own telling it where to write.
  a link of the image   the home gets the same link. Where the home has a real directory of that name (the machine's
                        ~/.claude: its login, the status shim, the volume's ~/.claude/projects mounted inside), the
                        directory moves to the link's target and the link takes its name: every path through
                        ~/.claude keeps working on the machine's side, and in the sandbox the supervisor's mount
                        covers ~/.harness, so the same link leads to the conversation's files in magpie
  a file of the image   copied when the home has none of that name
  a directory           made
Run again, it changes nothing.

The move is one atomic exchange where the filesystem allows it. A new machine's root is an overlay whose ~/.claude
comes from several image layers, and renaming such a directory is refused (EXDEV; seen on the first replica run,
2026-11-14): there its files are copied, what is mounted inside (the volume's ~/.claude/projects) is bound at the new
place and unmounted at the old, and the link replaces the emptied directory. This runs first thing in the harness,
before anything of the session writes there; a directory that reappears meanwhile is taken in on the next try."""
import ctypes, errno, os, shutil, subprocess, sys

RENAME_EXCHANGE = 2
AT_FDCWD = -100


def exchange(a, b):
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.renameat2(AT_FDCWD, a.encode(), AT_FDCWD, b.encode(), RENAME_EXCHANGE) != 0:
        e = ctypes.get_errno()
        raise OSError(e, os.strerror(e), a)


def run(*cmd):
    subprocess.run(cmd, check=True)


def mounts_under(d):
    """The mount points inside d, outermost first."""
    out = subprocess.run(["findmnt", "-rn", "-o", "TARGET"], check=True, capture_output=True, text=True).stdout
    return sorted(t for t in out.splitlines() if t.startswith(d + "/"))


def carry(claude, inner, target):
    """Without a rename: copy, bind what is mounted inside at the new place, empty the old, link."""
    for _ in range(5):
        os.makedirs(inner, exist_ok=True)
        run("cp", "-ax", claude + "/.", inner + "/")  # -x: a mount point inside is made, its files are not copied
        for m in mounts_under(claude):
            to = os.path.join(inner, os.path.relpath(m, claude))
            if to not in mounts_under(inner):
                run("sudo", "-n", "mount", "--bind", m, to)
        for m in reversed(mounts_under(claude)):
            run("sudo", "-n", "umount", m)
        shutil.rmtree(claude)
        try:
            os.symlink(target, claude)
            return
        except FileExistsError:
            continue  # something made ~/.claude again in between: take that in too
    sys.exit(f"aviary-home: {claude} kept reappearing")


def link(home, name, target):
    """home/name is the link to target; a real directory of that name moves to the target."""
    claude, inner = os.path.join(home, name), os.path.normpath(os.path.join(home, target))
    if os.path.islink(claude):
        if os.readlink(claude) != target:
            sys.exit(f"aviary-home: {claude} is a link to {os.readlink(claude)}, not to {target}")
    elif os.path.isdir(claude):
        if os.path.lexists(inner):
            sys.exit(f"aviary-home: both {claude} and {inner} exist")
        os.makedirs(os.path.dirname(inner), exist_ok=True)
        os.symlink(target, inner)  # the link, made under its future target's name
        try:
            if os.environ.get("AVIARY_HOME_TEST_NO_EXCHANGE"):  # the test's stand-in for the overlay's refusal
                raise OSError(errno.EXDEV, "test")
            exchange(inner, claude)  # atomically: the link is ~/.claude, the directory is ~/.harness/claude
        except OSError as e:
            os.remove(inner)
            if e.errno != errno.EXDEV:
                raise
            carry(claude, inner, target)
    elif os.path.lexists(claude):
        sys.exit(f"aviary-home: {claude} is a file where the image has a link")
    else:
        os.makedirs(inner, exist_ok=True)  # the machine's side of the link (its own files; hidden in the sandbox)
        os.symlink(target, claude)


def main():
    home, image_home = sys.argv[1], sys.argv[2]
    entries = sorted(os.listdir(image_home))
    if not any(os.path.islink(os.path.join(image_home, n)) for n in entries):
        sys.exit(f"aviary-home: {image_home} has no link: not an aviary sandbox image's home")
    for name in entries:
        src, dst = os.path.join(image_home, name), os.path.join(home, name)
        if os.path.islink(src):
            link(home, name, os.readlink(src))
        elif os.path.isdir(src):
            os.makedirs(dst, exist_ok=True)
        elif not os.path.lexists(dst):
            shutil.copyfile(src, dst)


if __name__ == "__main__":
    main()
