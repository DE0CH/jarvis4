#!/usr/bin/env python3
"""Have the supervisor pull this session's secret stores from the core into its RAM now. Hands NO secret to the caller.

The supervisor (jarvis-machine, machine/secrets.go) holds the session's stores in RAM; this asks it to take the
router's newest cert for this machine and pull the stores it names from the core (what add-store's background waiter
and a downgrade do). Use it after a store was added or refreshed, when the waiter hasn't pulled yet.

Pulling never gives the caller a value: nothing is printed, nothing is put in an environment, no file is written. It
prints only the cert's stores and the key names the supervisor now holds. A command gets the keys it needs with the
separate `session-secret --keys K1,K2 --exec CMD` (which never pulls).

Usage:
  pull-secrets          # pull now; prints the stores and the key names
  pull-secrets --quiet  # pull now; prints only a count

Anything else (--help, a typo, an extra argument) prints this usage and exits 2 WITHOUT asking the supervisor.
It asks the supervisor's unix socket (/run/jarvis/secrets.sock, only this user can reach it); the supervisor log
records the pull and this process's pid.
"""
import json, socket, sys

SOCK = "/run/jarvis/secrets.sock"


def die(msg, code=1):
    print(f"pull-secrets: {msg}", file=sys.stderr); sys.exit(code)


def usage():
    print(__doc__.strip(), file=sys.stderr); sys.exit(2)


def ask(req):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(20 * 60)  # a pull waits for a locked store
        s.connect(SOCK)
        s.sendall((json.dumps(req) + "\n").encode())
        buf = b""
        while True:
            b = s.recv(65536)
            if not b:
                break
            buf += b
        s.close()
        r = json.loads(buf.decode() or "{}")
    except (OSError, ValueError) as e:
        die(f"the supervisor's secrets aren't reachable ({e.__class__.__name__})")
    if not r.get("ok"):
        die("the supervisor said: " + str(r.get("error", "no answer"))[:300])
    return r


def main():
    a = sys.argv[1:]
    if a not in ([], ["--quiet"]):  # validate BEFORE asking
        usage()
    r = ask({"op": "reload"})
    names, stores = r.get("names") or [], r.get("stores") or []
    if a == ["--quiet"]:
        print(f"pulled: {len(names)} key(s)")
        return
    print(f"pulled: stores {', '.join(stores) or '(none)'}; {len(names)} key(s)")
    for k in names: print(k)


if __name__ == "__main__":
    main()
